# Variables the services read. In the cluster the Helm chart sets them; this file is only a reference
# for running a service on its own. Model endpoints, API keys and Kafka credentials are not
# environment variables: they are entered on the System Config page and saved in CONFIG_PATH.

# development runs Next.js and uvicorn with live reload; production runs the built app.
ENV=development
# Port the service listens on: app-ui 3000, kafka-service 8001, llm-service 8002, video-service 8003.
PORT=3000
# Settings file written by app-ui and read by the backends.
CONFIG_PATH=/app/data/config.json
# llm-service lists KServe InferenceServices across all namespaces; it falls back to this one only
# when it may not list cluster-wide.
KSERVE_NAMESPACE=default
