# Paths Tilt neither watches nor sends to the image build. The chart, Tiltfile and dev values stay watched (a change
# redeploys); .dockerignore keeps them out of the images.
.git
**/node_modules/
**/.next/
**/dist/
**/.venv/
**/__pycache__/
**/*.tgz
# Recordings at the root; the demo videos in assets/videos/ are baked into video-service.
*.mp4
# Editor temp files and test caches: they match no sync() path, so Tilt would rebuild the image for them.
**/*.tmp.*
**/*.swp
**/.pytest_cache/
**/pytest-cache-files-*/
**/.ruff_cache/
**/.mypy_cache/
